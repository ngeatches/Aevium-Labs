# Copy to .env.local (ignored) for local use, or enter these in the host's secret settings.
# Never commit real values. Unquoted KEY=value lines. Run `npm run check-config` to validate.

# ── Mode ──────────────────────────────────────────────────────────────
# demo (default): local simulation on 127.0.0.1 only — on-screen codes, captured emails, draft prices.
# off: order API disabled.   live: real Twilio Verify + Resend (staging/production only).
COMMERCE_MODE=demo
PREVIEW_PASSWORD=
# PORT=4173

# ── Live mode only (staging / production) ─────────────────────────────
# DEPLOY_ENV=staging                      # staging | production — separate databases and providers
# PUBLIC_ORIGIN=https://staging.example.com
# HOST=0.0.0.0
# TRUST_PROXY_HOPS=1                      # Render: 1
# DATA_DIR=/var/data                      # persistent disk; database = principium-<DEPLOY_ENV>.sqlite
# BACKUP_DIR=                             # default: $DATA_DIR/backups
# ACCESS_GATE=password                    # password (staging, default) | public (production only)
# ALLOW_INDEXING=                         # yes = allow search engines (public production only)

# Phone sign-in — Twilio Verify (Console → Verify → Services; API key from Account → API keys)
# TWILIO_ACCOUNT_SID=                     # AC…
# TWILIO_API_KEY_SID=                     # SK…
# TWILIO_API_KEY_SECRET=
# TWILIO_VERIFY_SERVICE_SID=              # VA…
# ADMIN_PHONES=+1XXXXXXXXXX               # comma-separated, owner-approved; the ONLY admin identities
# SMS_DAILY_LIMIT=300                     # global daily cap on sign-in texts (toll-fraud guard)

# Transactional email — Resend (verified sending domain required)
# RESEND_API_KEY=                         # re_…  (sending-only key recommended)
# RESEND_WEBHOOK_SECRET=                  # whsec_…  from the webhook pointing at /api/webhooks/resend
# MAIL_FROM=Principium Peptides <orders@example.com>
# MAIL_REPLY_TO=support@example.com

# Delivery safety
# DELIVERY_MODE=test                      # test: only the allowlists below receive SMS/email
# TEST_PHONE_ALLOWLIST=+1XXXXXXXXXX       # must include every ADMIN_PHONES number in test mode
# TEST_EMAIL_ALLOWLIST=you@example.com
# LAUNCH_APPROVED=                        # set to yes together with DELIVERY_MODE=open (production) to launch

# Verified business content (JSON, not secret; keep the repository private)
# BUSINESS_CONFIG=config/business.json    # template: config/business.example.json
# CATALOG_CONFIG=config/catalog.json      # template: config/catalog.example.json
